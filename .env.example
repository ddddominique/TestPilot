# Optional. Public repositories work without a token, but have a lower rate limit.
GITHUB_TOKEN=your_github_token_here

# Required only for --generate-tests. Never commit a real API key.
OPENAI_API_KEY=your_openai_api_key_here
# Optional structured-output-capable model override.
OPENAI_MODEL=gpt-4o-mini

# Phase 4.1 local PostgreSQL. Development placeholders, not real credentials.
POSTGRES_DB=testpilot
POSTGRES_USER=testpilot
POSTGRES_PASSWORD=change_me_for_local_development
DATABASE_URL=postgresql+psycopg://testpilot:change_me_for_local_development@localhost:5432/testpilot
